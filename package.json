  "keywords": [],
  "devDependencies": {
    "compromise": "^14.17.0",
    "de-compromise": "^0.1.1",
    "es-compromise": "^0.3.1",
    "fr-compromise": "^0.3.1",
    "it-compromise": "^0.3.1",
    "ja-compromise": "^0.1.0",
